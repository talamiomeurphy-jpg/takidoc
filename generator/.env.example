# ============================================================
# TAKIDOC GENERATOR — Variables d'environnement (exemple)
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE COMMITEZ JAMAIS le fichier .env dans Git.
# ============================================================

# Port du serveur (Render injecte automatiquement PORT)
PORT=3001

# URL du site TakiDoc (pour CORS)
ALLOWED_ORIGINS=http://localhost:5500,https://takidoc.onrender.com

